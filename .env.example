# Copy this file to .env.local and fill in real values. .env.local is
# git-ignored; never commit real secrets.

# --- Supabase (Phase 2 — required now) -------------------------------------
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client,
# never prefix with NEXT_PUBLIC_. Not used yet (no admin/service scripts
# exist until the moderation phase); add it when that lands.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin, used to build auth email / OAuth redirect links.
# Falls back to the request's own host when unset, which is fine for local
# dev — set this explicitly once a production domain exists.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Added in later phases (not used yet — left here so the full set of
# accounts to provision is visible up front; uncomment as each phase needs
# it) -------------------------------------------------------------------
# Map tiles (Phase 4 — search & map).
# MAPTILER_API_KEY=

# Cloudflare R2 — listing image storage (Phase 5 — listings/media).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=

# Claude API — the natural-language search chatbot (Phase 9 — AI chatbot).
# ANTHROPIC_API_KEY=
